<view class="page"><view class="page-title">喂宠服务记录</view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">刷新</button></view><view wx:for="{{visits}}" wx:key="_id" class="card"><view class="section-title">{{item.date}} · 第 {{item.seq}} 次</view><view>{{item.status === 'done' ? '已完成' : item.status === 'missed' ? '未完成' : '待服务'}}</view><image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill"/><video wx:if="{{item.videoFileId}}" src="{{item.videoFileId}}" controls/></view></view>
