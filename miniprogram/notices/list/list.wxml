<view class="page"><view class="page-title">小区公告</view><view wx:if="{{loading && !list.length}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{list}}" wx:key="_id" class="card"><view class="section-title">{{item.title}}<text wx:if="{{item.pinned}}" class="notice-label">置顶</text></view><view>{{item.body}}</view><private-media media-class="media-photo" wx:if="{{item.imageFileId}}" src="{{item.imageFileId}}" mode="widthFix"/><view class="muted">{{item.createdText}}</view></view><button wx:if="{{hasMore}}" loading="{{loading}}" bindtap="loadMore">查看更多公告</button><view wx:if="{{!loading && !list.length}}" class="muted">暂无公告</view></view>
