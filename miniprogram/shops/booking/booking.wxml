<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/shop.png"/><view class="masthead-copy"><view class="page-title">提交预约</view><view class="masthead-subtitle">发现身边的生活服务</view></view></view><view class="card">请简要说明需求，商家会根据预约内容提供服务或报价。</view><picker wx:if="{{addresses.length}}" range="{{addresses}}" range-key="label" value="{{addressIndex}}" bindchange="address"><view class="card">上门地址：{{addresses[addressIndex].label}}</view></picker><view wx:else class="card">使用当前绑定门牌地址</view><textarea class="ui-textarea card" maxlength="500" placeholder="服务需求（最多 500 字）" value="{{requirement}}" bindinput="input"/><view wx:if="{{error}}" class="error">{{error}}</view><button type="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交预约</button></view>
