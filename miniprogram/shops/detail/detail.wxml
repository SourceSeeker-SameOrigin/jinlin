<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{merchant}}"><view class="card"><view class="page-title">{{merchant.name}}</view><view>营业执照名称：{{merchant.licenseInfo.name}}</view><view>统一社会信用代码：{{merchant.licenseInfo.creditCode}}</view><view>评分：{{merchant.ratingText}}</view></view><view class="section-title">可预约服务</view><view wx:for="{{list}}" wx:key="_id" class="card"><view class="section-title">{{item.title}}</view><view>{{item.desc}}</view><view wx:if="{{item.priceType === 'fixed'}}">固定价：{{item.priceText}} / {{item.unit}}</view><view wx:else>预约后商家报价</view><button type="primary" data-id="{{item._id}}" bindtap="book">预约</button></view><view wx:if="{{!list.length}}" class="card">暂无可预约服务</view></block><view wx:if="{{loading}}">正在加载…</view></view>
