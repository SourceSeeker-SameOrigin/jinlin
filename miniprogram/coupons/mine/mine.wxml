<view class="page"><view class="page-title">我的优惠券</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{list}}" wx:key="_id" class="card"><view class="section-title">{{item.name}} · {{item.discountText}}</view><view>{{item.thresholdText}}</view><view>有效期至 {{item.validText}}</view><view class="muted">{{item.statusText}}</view></view><view wx:if="{{loading}}">正在加载…</view><view wx:elif="{{!list.length && !error}}">还没有优惠券，去优惠券中心看看吧。</view><navigator class="card" url="/coupons/center/center">优惠券中心 ›</navigator></view>
