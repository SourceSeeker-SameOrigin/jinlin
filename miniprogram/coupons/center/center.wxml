<view class="page"><view class="page-title">优惠券中心</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{list}}" wx:key="_id" class="card"><view class="section-title">{{item.name}} · {{item.discountText}}</view><view>{{item.thresholdText}} · 有效 {{item.validDays}} 天</view><view class="muted">剩余 {{item.remaining}} 张</view><button type="primary" data-id="{{item._id}}" bindtap="claim" disabled="{{busy}}">领取</button></view><view wx:if="{{loading}}">正在加载…</view><view wx:elif="{{!list.length && !error}}">暂无可领取优惠券</view></view>
