<view class="page"><view class="page-title">小区配置</view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}</view><picker range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="chooseCommunity"><view class="picker">{{community.name || '选择小区'}}</view></picker><block wx:if="{{community}}"><view class="field"><text class="label">小区名称</text><input value="{{name}}" data-field="name" bindinput="input"/></view><view class="field"><text class="label">联合社区组 ID（同组小区共享联合内容；留空表示不加入）</text><input value="{{federationGroupId}}" data-field="federationGroupId" bindinput="input"/></view><view class="field"><text class="label">楼栋和单元（每行“楼栋名称:1单元,2单元”）</text><textarea value="{{unitsText}}" data-field="unitsText" bindinput="input"/></view><button bindtap="addBuilding">添加最后一行楼栋</button><view class="field"><text class="label">驿站列表 JSON</text><textarea value="{{stationsText}}" data-field="stationsText" bindinput="input"/></view><view class="field"><text class="label">价格配置 JSON（金额为分）</text><textarea value="{{pricesText}}" data-field="pricesText" bindinput="input"/></view><view class="field"><text class="label">值班时段 JSON</text><textarea value="{{dutyText}}" data-field="dutyText" bindinput="input"/></view><button type="primary" bindtap="saveCommunity" loading="{{saving}}">保存小区配置</button></block></view>
