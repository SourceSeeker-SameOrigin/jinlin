<view class="page">
  <view class="page-title">驿站账号审核</view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <view class="card" wx:for="{{rows}}" wx:key="_id">
    <view class="section-title">{{item.stationName}}</view>
    <view>申请人：{{item.applicant}} · {{item.phone}}</view>
    <view class="muted">提交时间：{{item.createdAt}}</view>
    <view class="row"><button data-index="{{index}}" data-status="rejected" bindtap="review" disabled="{{busy}}">拒绝</button><button type="primary" data-index="{{index}}" data-status="approved" bindtap="review" disabled="{{busy}}">通过并授权</button></view>
  </view>
  <view wx:if="{{loading}}" class="card">正在加载…</view>
  <view wx:if="{{!loading && !rows.length}}" class="card">暂无待审核申请</view>
</view>
<privacy-popup/>
