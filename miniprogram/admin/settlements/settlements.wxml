<view class="page"><view class="page-title">人工结算</view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><picker range="{{communities}}" range-key="name" value="{{communityIndex}}" data-field="communityIndex" bindchange="select"><view class="picker">{{communities[communityIndex].name || '选择小区'}}</view></picker><picker range="{{payees}}" value="{{payeeIndex}}" data-field="payeeIndex" bindchange="select"><view class="picker">收款对象：{{payees[payeeIndex]}}</view></picker><picker wx:if="{{payeeIndex === 0}}" range="{{providers}}" range-key="realName" value="{{providerIndex}}" data-field="providerIndex" bindchange="select"><view class="picker">{{providers[providerIndex].realName || '选择服务员'}}</view></picker><picker wx:if="{{payeeIndex === 2}}" range="{{merchants}}" range-key="name" value="{{merchantIndex}}" data-field="merchantIndex" bindchange="select"><view class="picker">{{merchants[merchantIndex].name || '选择商家'}}</view></picker><input wx:if="{{payeeIndex === 3}}" value="{{sellerOpenid}}" data-field="sellerOpenid" bindinput="input" placeholder="卖家 OpenID（留空查看全部）"/><view class="field"><text class="label">期间开始</text><picker mode="date" value="{{from}}" data-field="from" bindchange="input"><view class="picker">{{from}}</view></picker></view><view class="field"><text class="label">期间结束</text><picker mode="date" value="{{to}}" data-field="to" bindchange="input"><view class="picker">{{to}}</view></picker></view><view class="actions"><button bindtap="preview" disabled="{{busy}}">预览待结算</button><button type="primary" bindtap="create" disabled="{{busy}}">生成结算单</button><button bindtap="exportCsv">导出 CSV</button></view><view class="card" wx:for="{{preview}}" wx:key="providerId"><view>{{item.payee === 'property' ? '物业' : item.payee === 'merchant' ? (item.merchantName || item.merchantId) : item.payee === 'seller' ? item.sellerOpenid : item.providerId}} · ¥{{item.totalText}}</view><view>{{from}} 至 {{to}}</view><view>包含 {{item.ledgerIds.length}} 条账目</view></view><view class="section-title">结算记录</view><view class="card" wx:for="{{settlements}}" wx:key="_id"><view>{{item.payee === 'property' ? '物业' : item.payee === 'merchant' ? (item.merchantName || item.merchantId) : item.payee === 'seller' ? item.sellerOpenid : item.providerId}} · ¥{{item.totalText}}</view><view>{{item.period.from}} 至 {{item.period.to}} · {{item.status === 'paid' ? '已付' : '待付款'}}</view><button wx:if="{{item.status === 'draft'}}" data-id="{{item._id}}" bindtap="markPaid">标记已付</button></view></view>
