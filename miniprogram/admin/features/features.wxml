<view class="page"><view class="page-title">扩展功能开关</view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><view class="row"><button data-scope="global" bindtap="scope">全局默认</button><button data-scope="community" bindtap="scope">单小区覆盖</button></view><picker wx:if="{{scope === 'community'}}" range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="choose"><view class="picker">{{communities[communityIndex].name || '选择小区'}}</view></picker><view class="muted">小区开关覆盖全局默认值。依赖未满足时无法开启。</view><view class="card" wx:for="{{items}}" wx:key="key"><view class="row"><text class="section-title">{{item.label}}</text><switch checked="{{item.enabled}}" data-key="{{item.key}}" data-enabled="{{item.enabled}}" disabled="{{saving}}" bindchange="toggle"/></view><view>{{item.info}}</view><view class="muted">全局默认：{{item.global ? '开启' : '关闭'}} · 本小区：{{item.community === null ? '继承全局' : item.community ? '开启' : '关闭'}}</view></view></view>
