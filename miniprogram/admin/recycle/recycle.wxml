<view class="page"><view class="page-title">回收企业月度对账</view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{communities.length}}"><picker range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="select"><view class="picker">{{communities[communityIndex].name}}</view></picker><view class="field"><text class="label">期间开始</text><input type="date" data-field="from" value="{{from}}" bindinput="input"/></view><view class="field"><text class="label">期间结束</text><input type="date" data-field="to" value="{{to}}" bindinput="input"/></view><view class="muted">报表按已完成的回收订单，逐回收企业和品类统计重量及应付金额。</view><navigator class="card" url="/admin/exports/exports?type=recycle">前往统一数据导出 ›</navigator></block></view><privacy-popup/>
