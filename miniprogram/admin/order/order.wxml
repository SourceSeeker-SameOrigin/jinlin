<view class="page"><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{order}}"><view class="card"><view class="page-title">{{order.serviceName}} · {{order.statusText}}</view><view>{{order.orderNo}}</view><view>实付 ¥{{amount}}</view><view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view><view>{{slotText}}</view><view>住户电话：{{order.userPhone}}</view><view>备注：{{order.note || '无'}}</view><view wx:for="{{details}}" wx:key="key">{{item.label}}：{{item.value}}</view></view><view class="card" wx:if="{{order.photos.length}}"><view class="section-title">完成照片</view><image class="photo" wx:for="{{order.photos}}" wx:key="*this" src="{{item}}" data-url="{{item}}" bindtap="preview"/><image wx:if="{{order.receiptPhoto}}" class="photo" src="{{order.receiptPhoto}}" data-url="{{order.receiptPhoto}}" bindtap="preview"/></view><view class="card" wx:if="{{order.complaint}}"><view class="section-title">投诉信息</view><view>{{order.complaint.reason}}</view><view>{{order.complaint.text}}</view><view wx:if="{{order.complaint.resolution}}">处理说明：{{order.complaint.resolution.note}}</view></view><view class="card" wx:if="{{refunds.length}}"><view class="section-title">退款记录</view><view wx:for="{{refunds}}" wx:key="index"><view>¥{{item.amountText}} · {{item.statusText}}</view><view>{{item.reason}}</view><button wx:if="{{!readOnly && item.status === 'failed'}}" data-no="{{item.outRefundNo}}" bindtap="retryRefund" disabled="{{busy}}">重试退款</button></view></view><view class="card" wx:if="{{!readOnly && order.status === 'paid'}}"><view class="section-title">指派服务员</view><picker range="{{providers}}" range-key="realName" value="{{providerIndex}}" bindchange="provider"><view class="picker">{{providers[providerIndex].realName || '请选择服务员'}}</view></picker><button type="primary" bindtap="assign" disabled="{{busy || !providers.length}}">确认指派</button></view><button wx:if="{{!readOnly && canCancel}}" bindtap="cancel" disabled="{{busy}}">强制取消并退款</button><button bindtap="load">刷新订单</button></block></view>
