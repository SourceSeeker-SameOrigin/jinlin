<view class="page"><view wx:if="{{readOnly}}" class="muted">物业只读视图</view><view wx:if="{{isAdmin}}" class="card"><view class="section-title">政府养老补贴订单导出</view><picker mode="date" value="{{subsidyFrom}}" data-field="subsidyFrom" bindchange="date"><view class="picker">开始：{{subsidyFrom}}</view></picker><picker mode="date" value="{{subsidyTo}}" data-field="subsidyTo" bindchange="date"><view class="picker">结束：{{subsidyTo}}</view></picker><button bindtap="exportSubsidy" loading="{{exporting}}" disabled="{{exporting}}">导出业务明细 CSV</button><view class="muted">文件不含门牌、手机号、姓名和服务备注。</view></view><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="filter"><view class="picker">{{statuses[statusIndex]}} ▾</view></picker><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="retry"/><view class="card" wx:for="{{rows}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view wx:if="{{item.alerted}}" class="error">超时未接单，请处理</view><view wx:if="{{item.attentionAlert}}" class="error">探访异常：请联系住户跟进</view><view>{{item.serviceName}} · {{item.statusText}}</view><view>{{item.buildingName}} · ¥{{item.amount}}</view><view>{{item.createdText}}</view><view>查看详情 ›</view></view><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:elif="{{!error && !rows.length}}" message="没有符合条件的订单"/></view>
