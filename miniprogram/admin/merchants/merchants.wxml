<view class="page"><view class="page-title">商家入驻审核</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="inspect"><view class="section-title">{{item.name}} · {{item.categoryName}}</view><view>营业执照：{{item.licenseInfo.name}}</view><view>信用代码：{{item.licenseInfo.creditCode}}</view><private-media wx:if="{{item.licenseFileId}}" src="{{item.licenseFileId}}" mode="widthFix" media-class="license"/><view>{{item.contactName}} · {{item.phone}}</view></view><view wx:if="{{loading}}">正在加载…</view><view wx:elif="{{!list.length && !error}}" class="card">暂无待审核商家</view><view wx:if="{{selected}}" class="card"><view class="section-title">服务审核：{{selected.name}}</view><view wx:for="{{services}}" wx:key="_id" class="service"><view>{{item.title}} · {{item.priceType === 'fixed' ? '固定价 ' + item.price : '预约后报价'}} · {{item.status}}</view><button wx:if="{{item.status === 'off'}}" size="mini" data-id="{{item._id}}" data-status="on" bindtap="serviceStatus">上架</button><button wx:else size="mini" data-id="{{item._id}}" data-status="off" bindtap="serviceStatus">下架</button></view><button type="primary" data-approved="true" bindtap="review" disabled="{{busy}}">通过入驻</button><button data-approved="false" bindtap="review" disabled="{{busy}}">拒绝申请</button></view></view>
