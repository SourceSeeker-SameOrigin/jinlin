<view class="page"><view class="page-title">海报码</view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}</view><picker range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="changeCommunity"><view class="picker">{{communities[communityIndex].name || '选择小区'}}</view></picker><view class="section-title">楼栋海报码</view><view class="card" wx:for="{{buildings}}" wx:key="_id"><view>{{item.name}}</view><view class="muted">二维码场景：b={{item.shortCode}}</view><button data-type="building" data-id="{{item._id}}" bindtap="generate" loading="{{busy}}">生成 / 更新小程序码</button></view><view class="section-title">服务员推荐码</view><picker range="{{providers}}" range-key="realName" value="{{providerIndex}}" bindchange="providerChange"><view class="picker">{{providers[providerIndex].realName || '选择服务员'}}</view></picker><button data-type="provider" bindtap="generate" loading="{{busy}}">生成推荐海报</button><view wx:if="{{poster}}" class="card"><image class="poster" src="{{poster.tempFileURL}}" mode="widthFix" bindtap="preview"/><view>场景：{{poster.scene}}</view><button type="primary" bindtap="save">保存到相册</button></view></view>
