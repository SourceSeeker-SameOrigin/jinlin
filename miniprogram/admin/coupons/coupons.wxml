<view class="page">
  <view class="page-masthead"><image class="masthead-icon" src="/assets/icons/admin.png"/><view class="masthead-copy"><view class="page-title">优惠券模板</view><view class="masthead-subtitle">社区运营 · 按权限管理</view></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card">
    <view class="section-title">{{form.templateId ? '编辑模板' : '新建模板'}}</view>
    <input class="ui-input" placeholder="模板名称" value="{{form.name}}" data-field="name" bindinput="field"/>
    <picker range="{{kindOptions}}" value="{{kindIndex}}" bindchange="chooseKind"><view class="picker">类型 {{form.kind}}</view></picker>
    <input class="ui-input" type="number" placeholder="优惠值（分或百分比）" value="{{form.value}}" data-field="value" bindinput="field"/>
    <input class="ui-input" type="number" placeholder="优惠封顶（分）" value="{{form.maxOff}}" data-field="maxOff" bindinput="field"/>
    <input class="ui-input" type="number" placeholder="使用门槛（分）" value="{{form.threshold}}" data-field="threshold" bindinput="field"/>
    <input class="ui-input" placeholder="适用服务：all 或 express,trash,buy,help" value="{{form.servicesText}}" data-field="servicesText" bindinput="field"/>
    <input class="ui-input" placeholder="适用小区：all 或逗号分隔 ID" value="{{form.communitiesText}}" data-field="communitiesText" bindinput="field"/>
    <input class="ui-input" type="number" placeholder="有效天数" value="{{form.validDays}}" data-field="validDays" bindinput="field"/>
    <input class="ui-input" type="number" placeholder="发放总量" value="{{form.totalLimit}}" data-field="totalLimit" bindinput="field"/>
    <input class="ui-input" type="number" placeholder="每人限领" value="{{form.perUserLimit}}" data-field="perUserLimit" bindinput="field"/>
    <picker range="{{modeLabels}}" value="0" bindchange="chooseMode"><view class="picker">发放方式：{{form.issueMode}}</view></picker>
    <button class="ui-button" type="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存模板</button><button class="ui-button" bindtap="reset">清空</button>
  </view>
  <view class="section-title">现有模板</view>
  <view class="card" wx:for="{{rows}}" wx:key="_id"><view class="section-title">{{item.name}} · {{item.kind}}</view><view>已发 {{item.issued}} / {{item.totalLimit}} · {{item.status}}</view><button class="ui-button" data-index="{{index}}" bindtap="edit">编辑</button><button class="ui-button" data-index="{{index}}" bindtap="toggleStatus">{{item.status === 'active' ? '暂停发放' : '恢复发放'}}</button></view>
  <view class="card"><view class="section-title">管理员手动发券</view><picker range="{{rows}}" range-key="name" bindchange="templatePick"><view class="picker">选择模板</view></picker><input class="ui-input" placeholder="手机号（与用户编号二选一）" value="{{form.phone}}" data-field="phone" bindinput="field"/><input class="ui-input" placeholder="用户编号，多个用逗号分隔" value="{{form.userIdsText}}" data-field="userIdsText" bindinput="field"/><button class="ui-button" type="primary" bindtap="issue" disabled="{{saving}}">发放优惠券</button></view>
  <view wx:if="{{loading}}">正在加载…</view>
</view>
