<view class="page">
  <view class="page-title">公告与广告管理</view>
  <view wx:if="{{loading}}">正在加载…</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card">
    <view class="section-title">发布本小区公告</view>
    <input placeholder="标题" data-field="title" value="{{title}}" bindinput="input" />
    <textarea placeholder="公告正文" data-field="body" value="{{body}}" bindinput="input" />
    <button size="mini" data-field="imageFileId" bindtap="chooseImage">选择公告图片（选填）</button><view wx:if="{{imageFileId}}" class="muted">已上传，发布后异步审核</view>
    <picker mode="date" data-field="endAt" bindchange="input"><view class="picker">有效期至：{{endAt || '请选择日期'}}</view></picker>
    <view class="row"><text>置顶</text><switch checked="{{pinned}}" bindchange="togglePinned" /></view>
    <button loading="{{saving}}" bindtap="saveNotice">发布公告</button>
  </view>
  <view class="card">
    <view class="section-title">当前公告</view>
    <view wx:for="{{notices}}" wx:key="_id" class="row"><text>{{item.title}}</text><button size="mini" data-id="{{item._id}}" bindtap="endNotice">结束</button></view>
  </view>
  <view wx:if="{{isAdmin}}" class="card">
    <view class="section-title">录入首页广告</view>
    <input placeholder="广告标题" data-field="adTitle" value="{{adTitle}}" bindinput="input" />
    <button size="mini" data-field="adImage" bindtap="chooseImage">选择广告图片</button><view wx:if="{{adImage}}" class="muted">已上传，审核通过后展示</view>
    <picker range="{{adSlots}}" bindchange="adSlotChange"><view class="picker">广告位：{{adSlot}}</view></picker>
    <picker range="{{adTargetTypes}}" bindchange="adTargetTypeChange"><view class="picker">目标类型：{{adTargetType}}</view></picker>
    <input wx:if="{{adTargetType !== 'page'}}" placeholder="商家或活动 ID" data-field="adTargetId" value="{{adTargetId}}" bindinput="input" />
    <picker wx:if="{{adTargetType === 'page'}}" range="{{adPaths}}" bindchange="adPathChange"><view class="picker">小程序页面：{{adPath}}</view></picker>
    <picker mode="date" data-field="adStart" bindchange="input"><view class="picker">开始日期：{{adStart || '请选择'}}</view></picker>
    <picker mode="date" data-field="adEnd" bindchange="input"><view class="picker">结束日期：{{adEnd || '请选择'}}</view></picker>
    <input type="digit" placeholder="广告金额（元）" data-field="adPrice" value="{{adPrice}}" bindinput="input" />
    <picker range="{{adStatuses}}" bindchange="adStatusChange"><view class="picker">状态：{{adStatus}}</view></picker>
    <button loading="{{saving}}" bindtap="saveAd">保存广告</button>
    <view wx:for="{{ads}}" wx:key="_id" class="row">{{item.title}} · {{item.status}} · ¥{{item.priceYuan}} · {{item.paymentReceivedAt ? '已确认收款' : '未确认收款'}}<button wx:if="{{!item.paymentReceivedAt && item.price > 0}}" size="mini" data-id="{{item._id}}" bindtap="confirmAdReceived">确认已收款</button><button wx:if="{{item.status === 'live'}}" size="mini" data-id="{{item._id}}" bindtap="endAd">结束</button></view>
  </view>
</view>
