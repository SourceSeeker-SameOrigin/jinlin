<view class="page">
  <view class="page-masthead"><image class="masthead-icon" src="/assets/icons/admin.png"/><view class="masthead-copy"><view class="page-title">数据导出</view><view class="masthead-subtitle">社区运营 · 按权限管理</view></view></view>
  <view wx:if="{{error}}" class="error">{{error}}<button disabled="{{loading || communityLoading || busy}}" bindtap="load">重试</button></view>
  <view wx:if="{{loading || communityLoading}}" class="card">正在加载…</view>
  <block wx:if="{{ready && !loading}}">
    <picker disabled="{{busy}}" range="{{types}}" range-key="name" value="{{typeIndex}}" data-field="typeIndex" bindchange="select"><view class="picker">导出类型：{{types[typeIndex].name}}</view></picker>
    <picker disabled="{{busy}}" wx:if="{{typeIndex !== 1}}" range="{{communities}}" range-key="name" value="{{communityIndex}}" data-field="communityIndex" bindchange="select"><view class="picker">小区：{{communities[communityIndex].name || '选择小区'}}</view></picker>
    <picker disabled="{{busy}}" wx:if="{{typeIndex === 0}}" range="{{payees}}" value="{{payeeIndex}}" data-field="payeeIndex" bindchange="select"><view class="picker">收款对象：{{payees[payeeIndex]}}</view></picker>
    <picker disabled="{{busy}}" wx:if="{{typeIndex === 0 && payeeIndex === 0}}" range="{{providers}}" range-key="realName" value="{{providerIndex}}" data-field="providerIndex" bindchange="select"><view class="picker">服务员：{{providers[providerIndex].realName || '选择服务员'}}</view></picker>
    <picker disabled="{{busy}}" wx:if="{{typeIndex === 0 && payeeIndex === 2}}" range="{{merchants}}" range-key="name" value="{{merchantIndex}}" data-field="merchantIndex" bindchange="select"><view class="picker">商家：{{merchants[merchantIndex].name || '选择商家'}}</view></picker>
    <input disabled="{{busy}}" wx:if="{{typeIndex === 0 && payeeIndex === 3}}" value="{{sellerOpenid}}" data-field="sellerOpenid" bindinput="input" placeholder="卖家 OpenID（留空导出全部）"/>
    <picker disabled="{{busy}}" wx:if="{{typeIndex === 3}}" range="{{community.stations}}" range-key="name" value="{{stationIndex}}" data-field="stationIndex" bindchange="select"><view class="picker">驿站：{{community.stations[stationIndex].name || '选择驿站'}}</view></picker>
    <picker disabled="{{busy}}" mode="date" value="{{from}}" data-field="from" bindchange="select"><view class="picker">开始日期：{{from}}</view></picker>
    <picker disabled="{{busy}}" mode="date" value="{{to}}" data-field="to" bindchange="select"><view class="picker">结束日期：{{to}}</view></picker>
    <view wx:if="{{typeIndex === 1}}" class="muted">政府补贴导出仅包含已批准业务字段，不含门牌、姓名、手机号、备注、用户标识或照片。</view>
    <button type="primary" bindtap="exportData" disabled="{{busy || loading || !ready}}" loading="{{busy}}">生成并打开 CSV</button>
  </block>
</view>
<privacy-popup/>
