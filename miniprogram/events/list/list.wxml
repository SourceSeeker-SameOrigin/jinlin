<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view class="card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view class="section-title">{{item.title}}</view><view>{{item.startText}} · {{item.location}}</view><view class="muted">{{item.feeText}} · 剩余 {{item.remaining}} 个名额</view></view><view wx:if="{{loading}}" class="card">正在加载…</view><view wx:elif="{{!list.length && !error}}" class="card">暂时没有活动</view></view>
