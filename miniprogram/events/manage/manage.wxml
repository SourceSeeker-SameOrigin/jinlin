<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view class="card"><view class="section-title">创建活动</view><input placeholder="活动标题" value="{{title}}" data-field="title" bindinput="input"/><textarea placeholder="活动说明" value="{{desc}}" data-field="desc" bindinput="input"/><input placeholder="活动地点" value="{{location}}" data-field="location" bindinput="input"/><picker range="{{types}}" bindchange="typeChange"><view class="picker">活动类型：{{type}}</view></picker><input wx:if="{{type === 'interest'}}" type="digit" placeholder="报名费用（元）" value="{{fee}}" data-field="fee" bindinput="input"/><input type="number" placeholder="名额" value="{{capacity}}" data-field="capacity" bindinput="input"/><view>开始日期 <picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="input"><view class="picker">{{startDate}}</view></picker>时间 <picker mode="time" value="{{startTime}}" data-field="startTime" bindchange="input"><view class="picker">{{startTime}}</view></picker></view><view>结束日期 <picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="input"><view class="picker">{{endDate}}</view></picker>时间 <picker mode="time" value="{{endTime}}" data-field="endTime" bindchange="input"><view class="picker">{{endTime}}</view></picker></view><view>报名截止 <picker mode="date" value="{{deadlineDate}}" data-field="deadlineDate" bindchange="input"><view class="picker">{{deadlineDate}}</view></picker>时间 <picker mode="time" value="{{deadlineTime}}" data-field="deadlineTime" bindchange="input"><view class="picker">{{deadlineTime}}</view></picker></view><view wx:if="{{isAdmin}}"><input placeholder="赞助方名称（可选）" value="{{sponsorName}}" data-field="sponsorName" bindinput="input"/><input type="digit" placeholder="赞助金额（元）" value="{{sponsorAmount}}" data-field="sponsorAmount" bindinput="input"/><input placeholder="赞助说明" value="{{sponsorNote}}" data-field="sponsorNote" bindinput="input"/></view><button type="primary" loading="{{busy}}" bindtap="createActivity">保存并提交活动审核</button></view><view class="card"><button bindtap="scan">扫描签到码</button><view wx:if="{{scanCode}}">签到码：{{scanCode}}</view></view><view class="card" wx:for="{{list}}" wx:key="_id"><view class="section-title">{{item.title}}</view><view>{{item.status}} · {{item.signupCount}}/{{item.capacity}} 人</view><view wx:if="{{item.reviewRequested}}" class="muted">待管理员审核</view><button wx:if="{{item.status === 'draft'}}" data-id="{{item._id}}" bindtap="publish">提交发布/审核</button><button wx:if="{{item.status === 'published'}}" data-id="{{item._id}}" bindtap="showSignups">查看报名名单</button><button data-id="{{item._id}}" bindtap="checkin">为此活动签到</button><button wx:if="{{item.status === 'published'}}" data-id="{{item._id}}" bindtap="cancel">取消活动</button><view wx:if="{{item.cancelRefund}}" class="muted">退款任务：{{item.cancelRefund.status}} · 完成 {{item.cancelRefund.completedCount}}/{{item.cancelRefund.totalCount}}<text wx:if="{{item.cancelRefund.retryCount}}"> · 待重试 {{item.cancelRefund.retryCount}}</text><text wx:if="{{item.cancelRefund.failedCount}}"> · 需处理 {{item.cancelRefund.failedCount}}</text></view><button wx:if="{{item.cancelRefund.status === 'attention' && item.cancelRefund.failedCount > 0}}" data-id="{{item._id}}" bindtap="retryCancellation">重试失败退款</button></view><view wx:if="{{loading}}" class="card">正在加载…</view><view class="card" wx:for="{{attendees}}" wx:key="signupId">{{item.status}} · {{item.checkinCode}}</view></view>
