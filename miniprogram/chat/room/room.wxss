.room{display:flex;flex-direction:column;height:100vh;box-sizing:border-box}.messages{flex:1;min-height:0;padding:20rpx}.message-row{display:flex;margin:16rpx 0;justify-content:flex-start}.message-row.mine{justify-content:flex-end}.bubble{max-width:78%;padding:18rpx 22rpx;border-radius:18rpx;background:#fff;word-break:break-word}.mine .bubble{background:#dff3e9}.time{font-size:20rpx;color:#888;margin-top:8rpx}.message-image{max-width:420rpx;border-radius:12rpx}.composer{display:flex;align-items:flex-end;gap:12rpx;padding:14rpx;background:#fff}.composer textarea{flex:1;max-height:180rpx;padding:12rpx;background:#f4f5f4;border-radius:10rpx}.notice{text-align:center;padding:24rpx}
