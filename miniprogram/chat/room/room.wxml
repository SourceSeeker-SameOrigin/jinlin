<view class="page room">
  <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{!conversationId}}" bindtap="start">重试</button></view>
  <scroll-view class="messages" scroll-y scroll-into-view="{{scrollTarget}}">
    <view wx:for="{{messages}}" wx:key="_id" id="message-{{item._id}}" class="message-row {{item.mine ? 'mine' : ''}}">
      <view class="bubble">
        <text wx:if="{{item.type === 'text'}}">{{item.content}}</text>
        <image wx:elif="{{item.fileId}}" class="message-image" src="{{item.fileId}}" mode="widthFix"/>
        <text wx:elif="{{item.status === 'pending'}}">图片审核中</text>
        <text wx:elif="{{item.status === 'blocked'}}">{{item.content}}</text>
        <view class="time">{{item.timeText}}</view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="muted">正在加载消息…</view>
    <view wx:if="{{readOnly}}" class="muted notice">会话已关闭，只能查看历史消息</view>
  </scroll-view>
  <view wx:if="{{!readOnly}}" class="composer"><textarea value="{{content}}" maxlength="500" auto-height placeholder="最多 500 字" bindinput="input"/><button bindtap="image" disabled="{{sending}}">图片</button><button type="primary" bindtap="send" loading="{{sending}}" disabled="{{sending}}">发送</button></view>
</view>
