<view class="page">
  <view class="page-title">发布{{type === 'task' ? '悬赏任务' : type === 'carry' ? '出行帮带' : '求助'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <input placeholder="标题" maxlength="100" value="{{title}}" data-field="title" bindinput="field"/>
  <textarea placeholder="说说具体情况" maxlength="2000" value="{{content}}" data-field="content" bindinput="field"/>
  <picker wx:if="{{federationEnabled && type !== 'task'}}" range="{{scopeOptions}}" value="{{scope === 'community' ? 0 : 1}}" bindchange="scope"><view class="picker">{{scope === 'community' ? '本小区' : '联合社区'}}</view></picker>
  <block wx:if="{{type === 'task'}}">
    <input type="digit" placeholder="悬赏金额（元，至少 3.00）" value="{{rewardYuan}}" data-field="rewardYuan" bindinput="field" />
    <picker mode="date" value="{{slotDate}}" start="{{today}}" data-field="slotDate" bindchange="choose"><view class="picker">服务日期 {{slotDate}}</view></picker>
    <picker range="{{slotOptions}}" range-key="label" value="{{slotIndex}}" data-field="slotIndex" bindchange="choose"><view class="picker">值班时段 {{slotLabel}}</view></picker>
    <checkbox-group bindchange="toggleEnterHome"><label><checkbox value="yes"/>服务需要进入家中（需认证服务员）</label></checkbox-group>
    <view class="notice">发布后需先支付悬赏金；支付成功后任务才会公开。</view>
  </block>
  <block wx:if="{{type === 'carry'}}">
    <picker range="{{directionOptions}}" value="{{direction === 'request' ? 0 : 1}}" bindchange="choose" data-field="direction"><view class="picker">{{direction === 'request' ? '求帮带' : '我能帮带'}}</view></picker>
    <input placeholder="目的地" maxlength="100" value="{{destination}}" data-field="destination" bindinput="field"/>
    <picker range="{{destinationTypes}}" value="{{destinationType === 'domestic' ? 0 : 1}}" bindchange="choose" data-field="destinationType"><view class="picker">{{destinationType === 'domestic' ? '境内' : '境外'}}</view></picker>
    <picker mode="date" value="{{departDate}}" data-field="departDate" bindchange="choose"><view class="picker">出发日期 {{departDate}}</view></picker>
    <picker mode="time" value="{{departTime}}" data-field="departTime" bindchange="choose"><view class="picker">出发时间 {{departTime}}</view></picker>
    <picker mode="date" value="{{returnDate}}" data-field="returnDate" bindchange="choose"><view class="picker">返程日期 {{returnDate}}</view></picker>
    <picker mode="time" value="{{returnTime}}" data-field="returnTime" bindchange="choose"><view class="picker">返程时间 {{returnTime}}</view></picker>
    <view wx:if="{{destinationType === 'overseas'}}" class="notice"><view>仅限个人自用、不加价、按海关规定如实申报；居民旅客境外获取物品免税额度为 5000 元，超出部分需申报纳税。</view><checkbox-group bindchange="agree"><label><checkbox value="agree"/>我已阅读并同意</label></checkbox-group></view>
  </block>
  <view wx:if="{{images.length}}">已选择 {{images.length}} 张图片</view><button bindtap="photos">添加图片（最多 3 张）</button>
  <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading}}">{{type === 'task' ? '发布并支付悬赏' : '发布'}}</button>
</view>
