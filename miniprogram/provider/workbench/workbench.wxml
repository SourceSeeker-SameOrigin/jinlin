<view class="page"><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><empty-state wx:if="{{!loading && !provider}}" message="你还没有提交服务员申请"/><navigator wx:if="{{!provider}}" url="/provider/apply/apply">申请成为服务员 ›</navigator><block wx:if="{{provider}}"><view class="card"><view class="section-title">{{provider.realName}}</view><view>{{provider.level === 2 ? '认证服务员' : '邻居帮手'}}</view><view>保险到期：{{insuranceText || '未登记，请联系管理员'}}</view><view wx:if="{{provider.status === 'approved'}}">上线值班 <switch checked="{{provider.onDuty}}" disabled="{{busy}}" bindchange="duty" color="#1F7A5C"/><view>本地剩余提醒次数：{{remainingReminders}}，仅供参考</view><view class="muted">{{reminderHint}}</view><button wx:if="{{remainingReminders < 3}}" bindtap="subscribeMore">补充新任务提醒</button><view>我的推荐码：{{provider.referralCode}}</view><button bindtap="saveReferralPoster">生成并保存推荐码</button></view><view wx:else>当前未获接单资格，请查看申请或联系管理员</view></view><view class="card"><view>今日完成 {{todayCount}} 单</view><view>今日收入 ¥{{todayIncome}}</view><navigator url="/provider/earnings/earnings">收入明细 ›</navigator></view><navigator class="card" url="/provider/hall/hall">进入任务大厅 ›</navigator><view class="section-title">当前任务</view><view class="card" wx:for="{{tasks}}" wx:key="_id" data-id="{{item._id}}" bindtap="task"><view>{{item.serviceName}} · {{item.statusText}}</view><view>{{item.buildingName}} · {{item.slotText}}</view><view>查看任务 ›</view></view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading}}">加载更多任务</button><empty-state wx:if="{{!loading && !tasks.length}}" message="当前没有任务"/></block></view>
