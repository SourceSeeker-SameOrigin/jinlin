<view class="page"><view class="muted">页面显示期间每 15 秒刷新一次</view><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="retry"/><view class="card" wx:for="{{tasks}}" wx:key="_id"><view class="section-title">{{item.serviceName}} · {{item.buildingName}}</view><view wx:if="{{item.title}}">{{item.title}}</view><view wx:if="{{item.desc}}">{{item.desc}}</view><view wx:if="{{item.serviceCode === 'custom'}}">{{item.needEnterHome ? '需认证服务员入户' : '无需入户'}}</view><view>{{item.slotText}}</view><view>预计服务收入 ¥{{item.income}}</view><button type="primary" data-id="{{item._id}}" disabled="{{busy}}" bindtap="accept">接单</button></view><empty-state wx:if="{{loading}}" message="正在加载任务…"/><empty-state wx:elif="{{!error && !tasks.length}}" message="暂时没有可接任务"/></view>
