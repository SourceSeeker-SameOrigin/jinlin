<view class="page"><view class="card"><view>待结算 ¥{{pending}}</view><view>已结算 ¥{{settled}}</view><view>可提现 ¥{{available}}</view><view class="muted">单次 ¥10—¥2000，每日 1 次</view><button wx:if="{{payoutEnabled}}" type="primary" loading="{{creatingPayout}}" disabled="{{creatingPayout || !canWithdraw}}" bindtap="createPayout">提现可用收入</button></view><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="retry"/><view class="section-title">提现记录</view><view class="card" wx:for="{{payouts}}" wx:key="payoutId"><view>¥{{item.amountText}} · {{item.stateText}}</view><view>{{item.time}}</view></view><view class="section-title">收入明细</view><view class="card" wx:for="{{rows}}" wx:key="_id"><view>¥{{item.amountText}} · {{item.settled ? '已结算' : item.locked ? '提现处理中' : '待结算'}}</view><view>{{item.time}}</view></view><empty-state wx:if="{{loading}}" message="正在加载收入…"/><empty-state wx:elif="{{!error && !rows.length}}" message="暂时没有收入明细"/></view>
