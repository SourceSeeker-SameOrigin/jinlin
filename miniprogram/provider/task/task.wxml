<view class="page"><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{order}}"><view class="card"><view class="page-title">{{order.serviceName}} · {{order.statusText}}</view><view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view><view>{{slotText}}</view><view>住户电话：{{order.userPhone}}</view><button wx:if="{{order.canCallResident}}" bindtap="callResident">联系住户</button><view wx:if="{{pickupText}}">取件码：{{pickupText}}</view><view wx:if="{{order.detail.stationCode}}">驿站：{{order.detail.stationCode}}</view><view wx:if="{{order.detail.shop}}">商店：{{order.detail.shop}}</view><view wx:if="{{order.detail.items}}">清单：{{order.detail.items}}</view><view wx:if="{{order.detail.desc}}">服务描述：{{order.detail.desc}}</view><view wx:if="{{order.detail.blocks}}">预计时长：{{order.detail.blocks * 15}} 分钟</view><view wx:if="{{order.detail.bags}}">垃圾：{{order.detail.bags}} 袋</view><view>备注：{{order.note || '无'}}</view></view><block wx:if="{{order.status === 'accepted'}}"><button type="primary" data-action="start" bindtap="act" disabled="{{busy}}">开始服务</button><button data-action="release" bindtap="act" disabled="{{busy}}">放弃任务</button></block><view class="card" wx:if="{{order.status === 'in_service'}}"><view class="section-title">完成凭证</view><view>拍摄服务结果，请勿拍摄无关人员或证件</view><image class="photo" wx:for="{{photos}}" wx:key="*this" src="{{item}}"/><button data-type="photos" bindtap="photo">拍摄完成照片（1—3 张）</button><block wx:if="{{order.serviceCode === 'buy'}}"><view>商品预付上限 ¥{{goodsCap}}</view><input type="digit" value="{{goodsYuan}}" bindinput="goods" placeholder="实际商品金额（元）"/><image wx:if="{{receiptPhoto}}" class="photo" src="{{receiptPhoto}}"/><button data-type="receipt" bindtap="photo">拍摄小票</button></block><button type="primary" data-action="deliver" bindtap="act" disabled="{{busy}}" loading="{{busy}}">提交完成</button></view><view wx:if="{{order.status === 'delivered'}}" class="card">已提交完成，等待住户确认</view></block></view><privacy-popup/>
