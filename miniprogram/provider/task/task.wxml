<view class="page"><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{order}}"><view class="card"><view class="page-title">{{order.serviceName}} · {{order.statusText}}</view><view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view><view>{{slotText}}</view><view>住户电话：{{order.userPhone}}</view><button wx:if="{{order.canCallResident}}" bindtap="callResident">联系住户</button><button wx:if="{{order.chatEnabled}}" bindtap="openChat">站内聊天</button><view wx:if="{{pickupText}}">取件码：{{pickupText}}</view><view wx:if="{{order.detail.stationCode}}">驿站：{{order.detail.stationCode}}</view><view wx:if="{{order.detail.shop}}">商店：{{order.detail.shop}}</view><view wx:if="{{order.detail.items}}">清单：{{order.detail.items}}</view><view wx:if="{{order.detail.desc}}">服务描述：{{order.detail.desc}}</view><view wx:if="{{order.serviceCode === 'pet'}}">服务日期：{{order.detail.dates}} · 每天 {{order.detail.visitsPerDay}} 次</view><view wx:if="{{order.serviceCode === 'pet'}}">入户方式：{{order.detail.entry}}</view><view wx:for="{{order.detail.pets}}" wx:key="kind">{{item.kind}} × {{item.count}}</view><view wx:if="{{order.serviceCode === 'pet'}}">事项：{{order.detail.tasks}}</view><button wx:if="{{order.serviceCode === 'pet'}}" bindtap="openPetTasks">喂宠上门清单</button><view wx:if="{{order.detail.blocks}}">预计时长：{{order.detail.blocks * 15}} 分钟</view><view wx:if="{{order.detail.bags}}">垃圾：{{order.detail.bags}} 袋</view><view>备注：{{order.note || '无'}}</view></view><block wx:if="{{order.status === 'accepted'}}"><button type="primary" data-action="start" bindtap="act" disabled="{{busy}}">开始服务</button><button data-action="release" bindtap="act" disabled="{{busy}}">放弃任务</button></block><view class="card" wx:if="{{order.status === 'in_service'}}"><view class="section-title">完成凭证</view><view>拍摄服务结果，请勿拍摄无关人员或证件</view><image class="photo" wx:for="{{photos}}" wx:key="*this" src="{{item}}"/><button data-type="photos" bindtap="photo">拍摄完成照片（1—3 张）</button><block wx:if="{{order.serviceCode === 'buy' || order.serviceCode === 'meal'}}"><view>商品预付上限 ¥{{goodsCap}}</view><input type="digit" value="{{goodsYuan}}" bindinput="goods" placeholder="实际商品金额（元）"/><image wx:if="{{receiptPhoto}}" class="photo" src="{{receiptPhoto}}"/><button data-type="receipt" bindtap="photo">拍摄小票</button></block><block wx:if="{{order.serviceCode === 'visit'}}"><view class="section-title">探访检查清单</view><checkbox-group bindchange="visitCheck"><label><checkbox value="mental" checked="{{visitChecks.mental}}"/>精神状态</label><label><checkbox value="diet" checked="{{visitChecks.diet}}"/>饮食情况</label><label><checkbox value="utilities" checked="{{visitChecks.utilities}}"/>用电用气安全</label><label><checkbox value="doors" checked="{{visitChecks.doors}}"/>门窗安全</label><label><checkbox value="medical" checked="{{visitChecks.medical}}"/>是否需要就医</label></checkbox-group><textarea maxlength="500" value="{{visitNotes}}" bindinput="visitNotes" placeholder="补充探访情况（最多 500 字）"/><view><switch checked="{{visitAttention}}" bindchange="visitAttention"/>需要关注</view><view wx:if="{{visitAttention}}"><view class="error">请先电话通知下单人</view><view wx:if="{{attentionCallConfirmed}}">已完成电话通知</view></view></block><button type="primary" data-action="deliver" bindtap="act" disabled="{{busy}}" loading="{{busy}}">提交完成</button></view><view wx:if="{{order.status === 'delivered'}}" class="card">已提交完成，等待住户确认</view></block></view><privacy-popup/>
