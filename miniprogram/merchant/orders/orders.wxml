<view class="page"><view class="page-title">商家预约订单</view><view class="muted">完成服务后需上传 1—3 张现场照片；住户确认后会进入人工周结。</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{list}}" wx:key="_id" class="card"><view class="section-title">{{item.serviceName}} · {{item.statusText}}</view><view>订单号：{{item.orderNo}}</view><view>{{item.address.buildingName}} {{item.address.unit}} {{item.address.room}}</view><view>住户需求：{{item.note || '无'}}</view><view>金额：¥{{item.amountText}}</view><view wx:if="{{item.quote}}">报价：¥{{item.quoteAmountText}} · {{item.quote.detail}}</view><button wx:if="{{item.featureEnabled && item.status === 'pending_quote'}}" data-id="{{item._id}}" bindtap="chooseQuote">填写报价</button><view wx:if="{{item.featureEnabled && quoteId === item._id}}"><input type="digit" placeholder="报价（元）" data-field="quoteAmount" value="{{quoteAmount}}" bindinput="input"/><input placeholder="报价说明" data-field="quoteDetail" value="{{quoteDetail}}" bindinput="input"/><button type="primary" bindtap="quote" loading="{{busy}}">提交报价并发起支付</button></view><button wx:if="{{item.featureEnabled && item.status === 'paid'}}" data-id="{{item._id}}" data-action="accept" bindtap="transition" disabled="{{busy}}">接单</button><button wx:if="{{item.featureEnabled && item.status === 'accepted'}}" data-id="{{item._id}}" data-action="start" bindtap="transition" disabled="{{busy}}">开始服务</button><button wx:if="{{item.featureEnabled && item.status === 'in_service'}}" data-id="{{item._id}}" bindtap="complete" disabled="{{busy}}">拍照并提交完成</button></view><view wx:if="{{loading}}">正在加载…</view><view wx:elif="{{!list.length && !error}}" class="card">暂无预约订单</view></view>
