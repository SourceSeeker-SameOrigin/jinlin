<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/shop.png"/><view class="masthead-copy"><view class="page-title">服务管理</view><view class="masthead-subtitle">管理服务，回应邻里所需</view></view></view><view class="card"><input class="ui-input" placeholder="服务名称" data-field="title" value="{{title}}" bindinput="input"/><textarea class="ui-textarea" placeholder="服务说明" data-field="desc" value="{{desc}}" bindinput="input"/><picker range="{{types}}" value="{{priceTypeIndex}}" bindchange="chooseType"><view class="picker">{{types[priceTypeIndex]}}</view></picker><input class="ui-input" wx:if="{{priceTypeIndex === 0}}" type="digit" placeholder="固定价（元）" data-field="price" value="{{price}}" bindinput="input"/><input class="ui-input" placeholder="计价单位" data-field="unit" value="{{unit}}" bindinput="input"/><button bindtap="photos">上传服务图片（最多 9 张）</button><private-media wx:for="{{images}}" wx:key="*this" src="{{item}}" media-class="photo"/><button type="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存为待审核服务</button><view class="muted">新服务默认下架；图片通过内容安全审核后，管理员才能上架。</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="card" wx:for="{{list}}" wx:key="_id"><view class="section-title">{{item.title}} · {{item.status === 'on' ? '已上架' : '已下架'}}</view><view>{{item.desc}}</view><private-media wx:for="{{item.images}}" wx:for-item="imageFileId" wx:key="*this" src="{{imageFileId}}" media-class="photo"/><view>{{item.priceType === 'fixed' ? '固定价（分）' : '预约后报价'}} {{item.price}}</view></view><view wx:if="{{loading}}">正在加载…</view></view>
