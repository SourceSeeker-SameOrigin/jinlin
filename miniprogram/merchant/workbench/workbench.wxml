<view class="page"><view class="page-title">商家工作台</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{merchant}}"><view class="card"><view class="section-title">{{merchant.name}}</view><view>入驻状态：{{merchant.status}}</view><view wx:if="{{merchant.reviewNote}}">审核说明：{{merchant.reviewNote}}</view><view wx:if="{{merchant.status === 'approved'}}"><button type="primary" bindtap="orders">预约订单与报价</button><button bindtap="services">管理服务</button></view></view></block><view wx:elif="{{!loading}}" class="card">尚未提交商家申请<button bindtap="apply">申请入驻</button></view><view wx:if="{{loading}}">正在加载…</view></view>
