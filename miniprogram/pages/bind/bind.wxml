<view class="page">
  <view class="page-title">服务送到您家门口</view>
  <view class="muted">请确认小区、门牌和联系电话</view>
  <view wx:if="{{loading}}" class="card">正在加载…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view>
  <view wx:if="{{!loading && !communities.length}}" class="card">暂时没有可服务的小区</view>
  <view wx:if="{{locationHint}}" class="muted">{{locationHint}}</view>
  <view wx:if="{{communities.length}}" class="card">
    <view class="field"><text class="label">小区</text><picker range="{{communities}}" range-key="displayName" value="{{communityIndex}}" bindchange="communityChange"><view class="picker">{{communities[communityIndex].displayName}} ›</view></picker></view>
    <view class="field"><text class="label">楼栋</text><picker range="{{buildings}}" range-key="name" value="{{buildingIndex}}" bindchange="buildingChange" disabled="{{!buildings.length}}"><view class="picker">{{buildings[buildingIndex].name || '请选择楼栋'}} ›</view></picker></view>
    <view class="field"><text class="label">单元</text><picker range="{{units}}" value="{{unitIndex}}" bindchange="unitChange" disabled="{{!units.length}}"><view class="picker">{{units[unitIndex] || '请选择单元'}} ›</view></picker></view>
    <view class="field"><text class="label">门牌号</text><input placeholder="例如：302" value="{{room}}" bindinput="roomChange" maxlength="30" /></view>
    <view class="field"><text class="label">联系人姓名（选填）</text><input placeholder="留空时使用当前账户" value="{{contactName}}" bindinput="contactNameChange" maxlength="30" /></view>
    <view class="field"><text class="label">本地址联系电话（选填）</text><input type="number" placeholder="留空时使用已授权手机号" value="{{contactPhone}}" bindinput="contactPhoneChange" maxlength="11" /></view>
    <checkbox-group bindchange="agreementChange"><label><checkbox value="agree" checked="{{agreed}}" color="#1F7A5C" />我已阅读并同意隐私政策和服务协议</label></checkbox-group>
    <view class="links"><navigator url="/pages/legal/privacy">隐私政策</navigator><navigator url="/pages/legal/terms">服务协议</navigator></view>
    <view class="field"><text class="label">联系电话</text><view wx:if="{{phone}}">{{phone}}</view><button open-type="getPhoneNumber" bindgetphonenumber="phone" disabled="{{!agreed}}">{{phone ? '更换授权手机号' : '授权手机号'}}</button></view>
    <button type="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || !agreed || !phone || !room}}">保存门牌</button>
  </view>
</view>
<privacy-popup />
