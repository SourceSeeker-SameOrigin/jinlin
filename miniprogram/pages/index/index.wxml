<view class="page">
  <view wx:if="{{loading}}" class="card">正在加载小区服务…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view>
  <block wx:elif="{{community}}">
    <view class="card"><view class="page-title">{{community.name}}</view><navigator url="/pages/bind/bind" class="muted">修改门牌 ›</navigator></view>
    <swiper wx:if="{{ads.length}}" class="home-ads" indicator-dots autoplay circular><swiper-item wx:for="{{ads}}" wx:key="_id" data-id="{{item._id}}" bindtap="openAd"><view class="ad-card"><image src="{{item.imageFileId}}" mode="aspectFill" data-id="{{item._id}}" bindload="recordAd"/><text class="ad-label">广告</text><text class="ad-title">{{item.title}}</text></view></swiper-item></swiper>
    <view wx:if="{{notice}}" class="notice card" bindtap="openNotices"><text class="notice-label">公告</text><text>{{notice.title}}</text><text class="muted">›</text></view>
    <view wx:if="{{firstOrder}}" class="offer">首单服务费低至 1 元<view class="muted">适用于取快递、扔垃圾和代买，商品款另计</view></view>
    <view class="services"><service-tile wx:for="{{services}}" wx:key="code" code="{{item.code}}" name="{{item.name}}" icon="{{item.icon}}"/></view>
    <navigator wx:if="{{community.enabledFeatures.idle}}" class="card" url="/idle/list/list"><view class="section-title">闲置交易 ›</view><view class="muted">看看邻居发布的闲置好物</view></navigator>
    <navigator wx:if="{{eventsEnabled}}" class="card" url="/events/list/list"><view class="section-title">社区活动</view><view class="muted">看看邻里正在举办的活动 ›</view></navigator>
    <navigator class="card" url="/pages/membership/index"><view class="section-title">经常需要帮忙？看看月卡</view><view class="muted">快递月卡 · 垃圾月卡 ›</view></navigator>
    <navigator wx:if="{{community.enabledFeatures.board}}" class="card" url="/board/list/list"><view class="section-title">需求广场 ›</view><view class="muted">看看邻居的求助和出行帮带</view></navigator>
    <navigator wx:if="{{community.enabledFeatures.coupons}}" class="card" url="/coupons/center/center"><view class="section-title">优惠券中心 ›</view></navigator>
    <button bindtap="callHotline">不会用？打电话下单</button>
  </block>
</view>
<privacy-popup />
