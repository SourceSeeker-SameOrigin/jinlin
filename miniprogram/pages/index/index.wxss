/* 通用页面样式位于 app.wxss。 */
.services { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin: 24rpx 0; }
.services button { width: 100%; padding: 24rpx; background: #fff; }
.icon { min-height: 160rpx; display: flex; align-items: center; justify-content: center; font-size: 80rpx; }
.offer { padding: 28rpx; border-radius: 20rpx; background: #e6f3eb; color: #15583f; font-weight: 600; }
.home-ads { height: 300rpx; margin: 20rpx 0; border-radius: 20rpx; overflow: hidden; }
.ad-card { position: relative; height: 100%; background: #e8eeea; }
.ad-card image { width: 100%; height: 100%; }
.ad-label { position: absolute; top: 16rpx; right: 16rpx; padding: 5rpx 12rpx; border-radius: 8rpx; color: #fff; background: #555; font-size: 22rpx; }
.ad-title { position: absolute; left: 18rpx; bottom: 16rpx; color: #fff; text-shadow: 0 1rpx 4rpx #222; }
.notice { display: flex; gap: 18rpx; align-items: center; }
.notice-label { color: #1f7a5c; font-weight: 600; }
