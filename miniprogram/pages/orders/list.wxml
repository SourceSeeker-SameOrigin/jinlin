<view class="page"><view class="tabs"><button wx:for="{{groups}}" wx:key="code" type="{{group === item.code ? 'primary' : 'default'}}" data-group="{{item.code}}" bindtap="groupChange">{{item.name}}</button></view><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="retry"/><order-card wx:for="{{orders}}" wx:key="_id" order="{{item}}"/><empty-state wx:if="{{loading}}" message="正在加载订单…"/><empty-state wx:elif="{{!error && !orders.length}}" message="这里还没有订单"/><button wx:if="{{hasMore && orders.length && !loading}}" bindtap="retry">加载更多</button></view>
