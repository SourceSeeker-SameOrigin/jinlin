<view class="page"><empty-state wx:if="{{loading}}" message="正在加载订单…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{order}}"><view class="card"><view class="page-title">{{order.statusText}}</view><view wx:if="{{order.status === 'paid'}}">服务员接单后会给您打电话</view><view>{{order.serviceName}} · ¥{{amount}}</view><view class="muted">订单号：{{order.orderNo}}</view></view><view class="card"><view class="section-title">服务信息</view><view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view><view>{{slotText}}</view><view wx:for="{{detailRows}}" wx:key="label">{{item.label}}：{{item.value}}</view><view wx:if="{{order.note}}">备注：{{order.note}}</view></view><view class="card" wx:if="{{order.provider}}"><view class="section-title">服务员</view><image wx:if="{{order.provider.avatarFileId}}" class="avatar" src="{{order.provider.avatarFileId}}" mode="aspectFill"/><view>{{order.provider.name}} · {{order.provider.level === 2 ? '认证服务员' : '邻居帮手'}}</view><view>{{order.provider.phone}}</view><button wx:if="{{order.provider.canCall}}" bindtap="callProvider">联系服务员</button></view><view class="card" wx:if="{{order.photos.length}}"><view class="section-title">完成照片</view><image wx:for="{{order.photos}}" wx:key="*this" class="photo" src="{{item}}" data-url="{{item}}" bindtap="preview" mode="aspectFill"/></view><view class="card" wx:if="{{refunds.length}}"><view class="section-title">退款记录</view><view wx:for="{{refunds}}" wx:key="index">¥{{item.amountText}} · {{item.statusText}}<view>{{item.reason}}</view></view></view><view class="card"><view class="section-title">服务进度</view><status-timeline items="{{timeline}}"/></view><button wx:if="{{order.canPay}}" type="primary" bindtap="pay" loading="{{busy}}" disabled="{{busy}}">继续支付</button><button wx:if="{{order.canCancel}}" bindtap="cancel" disabled="{{busy}}">取消订单</button><button bindtap="load">刷新订单</button></block></view>
