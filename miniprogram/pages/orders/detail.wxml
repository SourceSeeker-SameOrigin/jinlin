<view class="page"><empty-state wx:if="{{loading}}" message="正在加载订单…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{order}}"><view class="card"><view class="page-title">{{order.statusText}}</view><view wx:if="{{order.status === 'paid'}}">服务员接单后会给您打电话</view><view>{{order.serviceName}} · ¥{{amount}}</view><button wx:if="{{order.canChat}}" bindtap="openChat">站内聊天<text wx:if="{{unread}}"> · {{unread}} 条未读</text></button><view wx:if="{{order.pricing.couponDiscount}}">优惠券抵扣 ¥{{couponDiscountText}}</view><view wx:if="{{pointsRedeemed}}">环保积分抵扣 {{pointsRedeemed}} 分</view><view class="muted">订单号：{{order.orderNo}}</view></view><view class="card"><view class="section-title">服务信息</view><view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view><view>{{slotText}}</view><view wx:for="{{detailRows}}" wx:key="label">{{item.label}}：{{item.value}}</view><view wx:if="{{order.note}}">备注：{{order.note}}</view></view><view class="card" wx:if="{{order.provider}}"><view class="section-title">服务员</view><image wx:if="{{order.provider.avatarFileId}}" class="avatar" src="{{order.provider.avatarFileId}}" mode="aspectFill"/><view>{{order.provider.name}} · {{order.provider.level === 2 ? '认证服务员' : '邻居帮手'}}</view><view>{{order.provider.phone}}</view><button wx:if="{{order.provider.canCall}}" bindtap="callProvider">联系服务员</button></view><view class="card" wx:if="{{order.photos.length}}"><view class="section-title">完成照片</view><image wx:for="{{order.photos}}" wx:key="*this" class="photo" src="{{item}}" data-url="{{item}}" bindtap="preview" mode="aspectFill"/></view><view class="card" wx:if="{{refunds.length}}"><view class="section-title">退款记录</view><view wx:for="{{refunds}}" wx:key="index">¥{{item.amountText}} · {{item.statusText}}<view>{{item.reason}}</view></view></view><view class="card"><view class="section-title">服务进度</view><status-timeline items="{{timeline}}"/></view><button wx:if="{{order.canPay}}" type="primary" bindtap="pay" loading="{{busy}}" disabled="{{busy}}">继续支付</button><button wx:if="{{order.canCancel}}" bindtap="cancel" disabled="{{busy}}">取消订单</button><view class="card" wx:if="{{order.canConfirm}}"><button type="primary" data-action="confirm" bindtap="serviceAction" disabled="{{busy}}">确认服务完成</button></view><view class="card" wx:if="{{order.canRate}}"><view class="section-title">评价服务</view><view>评分（1—5 分）</view><input type="number" value="{{ratingScore}}" data-field="ratingScore" bindinput="form" maxlength="1"/><textarea value="{{ratingText}}" data-field="ratingText" bindinput="form" maxlength="100" placeholder="写下服务感受（选填）"/><button data-action="rate" bindtap="serviceAction" disabled="{{busy}}">提交评价</button></view><view class="card" wx:if="{{order.canComplain}}"><view class="section-title">申请售后</view><picker range="{{complaintReasons}}" value="{{complaintIndex}}" data-field="complaintIndex" bindchange="form"><view class="picker">{{complaintReasons[complaintIndex]}}</view></picker><textarea value="{{complaintText}}" data-field="complaintText" bindinput="form" maxlength="500" placeholder="请描述遇到的问题"/><button data-action="complain" bindtap="serviceAction" disabled="{{busy}}">提交投诉</button></view><view class="card" wx:if="{{order.rating}}">已评价 {{order.rating.score}} 分<view>{{order.rating.text}}</view></view><view class="card" wx:if="{{order.complaint}}"><view>售后原因：{{order.complaint.reason}}</view><view>{{order.complaint.text}}</view><view wx:if="{{order.complaint.resolution}}">处理结果：{{order.complaint.resolution.note}}</view></view><button bindtap="load">刷新订单</button></block></view>
