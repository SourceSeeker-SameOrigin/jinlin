<view class="page service-page"><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><block wx:if="{{community}}"><view class="card" bindtap="address"><text class="label">上门地址</text>{{addressText}}<view class="muted">点击修改门牌 ›</view></view><view class="card"><view class="field"><text class="label">服务类别</text><picker range="{{categories}}" value="{{form.categoryIndex}}" data-field="categoryIndex" bindchange="change"><view class="picker">{{categories[form.categoryIndex]}}</view></picker></view><view class="field"><text class="label">需要什么帮助（最多 200 字）</text><textarea value="{{form.desc}}" data-field="desc" bindinput="change" maxlength="200"/></view><view class="field"><text class="label">预计时长（每块 15 分钟，1—8 块）</text><input type="number" value="{{form.blocks}}" data-field="blocks" bindinput="change"/><text class="muted">仅由认证服务员提供，按预计时长收费。</text></view><view class="field"><text class="label">上门时间</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || "请选择时段"}}</view></picker><view class="muted">{{dutyHint}}</view></view><view class="field"><text class="label">备注（选填）</text><textarea value="{{form.note}}" data-field="note" bindinput="change" maxlength="100" placeholder="请填写需要服务员注意的事项"/></view></view><view wx:if="{{quoteError}}" class="error">{{quoteError}}<button class="retry" bindtap="retryQuote">重新报价</button></view><view wx:if="{{quoteLoading}}">正在重新报价…</view><price-bar amount="{{amount}}" reason="{{quote.reason}}" disabled="{{!quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view>
