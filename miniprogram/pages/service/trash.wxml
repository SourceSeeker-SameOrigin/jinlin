<view class="page service-page"><view wx:if="{{restoredDraft}}" class="card restored">已恢复上次未完成的填写内容</view><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><block wx:if="{{community}}"><view class="card" bindtap="address"><text class="label">上门地址</text>{{addressText}}<view class="muted">点击修改门牌 ›</view></view><view class="card"><view class="card" wx:if="{{hasTrashMembership}}">你已有月卡，无需单次下单。<navigator url="/pages/membership/index">查看月卡安排 ›</navigator></view><view class="field"><text class="label">垃圾袋数（1—3 袋）</text><input type="number" value="{{form.bags}}" data-field="bags" bindinput="change"/></view><checkbox-group data-field="sorted" bindchange="change"><label><checkbox value="sorted" checked="{{form.sorted}}"/>我已按当地要求分好类，并放在门口</label></checkbox-group><view class="field"><text class="label">上门时间</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || "请选择时段"}}</view></picker><view class="muted">{{dutyHint}}</view></view><view class="field"><text class="label">备注（选填）</text><textarea value="{{form.note}}" data-field="note" bindinput="change" maxlength="100" placeholder="请填写需要服务员注意的事项"/></view></view><view wx:if="{{quoteError}}" class="error">{{quoteError}}<button class="retry" bindtap="retryQuote">重新报价</button></view><view wx:if="{{quoteLoading}}">正在重新报价…</view><price-bar amount="{{amount}}" reason="{{quote.reason}}" disabled="{{!quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view>
