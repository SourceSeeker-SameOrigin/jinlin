<view class="page service-page"><view wx:if="{{restoredDraft}}" class="card restored">已恢复上次未完成的填写内容</view><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><block wx:if="{{community}}"><view class="card"><view class="field" wx:if="{{addresses.length > 1}}"><text class="label">服务地址</text><picker range="{{addresses}}" range-key="buildingName" value="{{addressIndex}}" bindchange="addressChange"><view class="picker">{{addressText}} · 切换地址</view></picker></view><view wx:else bindtap="address"><text class="label">上门地址</text>{{addressText}}<view class="muted">点击添加/修改服务地址 ›</view></view></view><view class="card"><view class="field"><text class="label">店名</text><input value="{{form.shop}}" data-field="shop" bindinput="change" maxlength="100"/></view><view class="field"><text class="label">代买清单（最多 200 字）</text><textarea value="{{form.items}}" data-field="items" bindinput="change" maxlength="200" placeholder="请写明商品、数量和替代要求"/></view><view class="field"><text class="label">商品预付上限（元）</text><input type="digit" value="{{form.goodsYuan}}" data-field="goodsYuan" bindinput="change"/><text class="muted">商品款不参与服务费折扣，完成后凭小票退还差额。</text></view><view class="field"><text class="label">上门时间</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || "请选择时段"}}</view></picker><view class="muted">{{dutyHint}}</view></view><view class="field"><text class="label">备注（选填）</text><textarea value="{{form.note}}" data-field="note" bindinput="change" maxlength="100" placeholder="请填写需要服务员注意的事项"/></view></view><discount-selector wx:if="{{quote && (couponsEnabled || pointsEnabled)}}" coupon-options="{{couponOptions}}" coupons-enabled="{{couponsEnabled}}" points-enabled="{{pointsEnabled}}" points-balance="{{pointsBalance}}" points-to-use="{{pointsToUse}}" bind:couponchange="couponChange" bind:pointschange="pointsChange"/><view wx:if="{{quoteError}}" class="error">{{quoteError}}<button class="retry" bindtap="retryQuote">重新报价</button></view><view wx:if="{{quoteLoading}}">正在重新报价…</view><price-bar amount="{{amount}}" reason="{{quote.reason}}" disabled="{{!quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view>
