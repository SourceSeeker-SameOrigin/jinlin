<view class="page service-page"><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><block wx:if="{{community}}"><view class="card" bindtap="address"><text class="label">上门地址</text>{{addressText}}<view class="muted">点击修改门牌 ›</view></view><view class="card"><view class="field"><text class="label">取件驿站</text><picker range="{{community.stations}}" range-key="name" value="{{form.stationIndex}}" data-field="stationIndex" bindchange="change"><view class="picker">{{community.stations[form.stationIndex].name || "请选择驿站"}}</view></picker></view><view class="field"><text class="label">取件码（每行一个，最多 10 个）</text><textarea value="{{form.pickupText}}" maxlength="220" data-field="pickupText" bindinput="change" placeholder="请输入取件码" /></view><view class="field"><text class="label">其中大件数量</text><input type="number" value="{{form.largeCount}}" data-field="largeCount" bindinput="change"/><text class="muted">单边超过 50 厘米或超过 10 公斤算大件</text></view><view class="field"><text class="label">交付方式</text><picker range="{{placements}}" value="{{form.placementIndex}}" data-field="placementIndex" bindchange="change"><view class="picker">{{placements[form.placementIndex]}}</view></picker></view><view class="field"><text class="label">上门时间</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || "请选择时段"}}</view></picker><view class="muted">{{dutyHint}}</view></view><view class="field"><text class="label">备注（选填）</text><textarea value="{{form.note}}" data-field="note" bindinput="change" maxlength="100" placeholder="请填写需要服务员注意的事项"/></view></view><view wx:if="{{quoteError}}" class="error">{{quoteError}}<button class="retry" bindtap="retryQuote">重新报价</button></view><view wx:if="{{quoteLoading}}">正在重新报价…</view><price-bar amount="{{amount}}" reason="{{quote.reason}}" disabled="{{!quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view>
