<view class="page"><empty-state wx:if="{{loading}}" message="正在加载月卡…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><view class="section-title">选择月卡</view><view class="card" wx:for="{{plans}}" wx:key="code"><view class="section-title">{{item.name}} · {{item.days}} 天</view><view class="price">¥{{item.priceText}} <text wx:if="{{item.first}}">首期优惠</text></view><view wx:if="{{item.first}}">续期价格 ¥{{item.originalText}}</view><view wx:if="{{item.serviceCode === 'express'}}">每日 {{item.dailyParcelQuota}} 件以内免费，超额整单按原价</view><block wx:if="{{item.serviceCode === 'trash'}}"><view>每天上门一次，请选择时段并提前分类放在门口</view><picker range="{{slots}}" value="{{slotIndex}}" bindchange="slot"><view class="picker">{{slots[slotIndex]}}</view></picker></block><button type="primary" data-code="{{item.code}}" bindtap="buy" disabled="{{busy}}" loading="{{busy}}">购买 / 续期</button></view><view class="muted">月卡暂不支持自行退款，如需处理请联系客服。</view><view class="section-title">我的月卡</view><view class="card" wx:for="{{cards}}" wx:key="_id"><view>{{item.name}} · {{item.statusText}}</view><view>开始：{{item.startText}}</view><view>到期：{{item.endText}}</view><view wx:if="{{item.serviceCode === 'trash'}}">上门：{{item.slot === 'morning' ? '早班' : '晚班'}}</view><button wx:if="{{item.serviceCode === 'trash' && item.status === 'active'}}" data-id="{{item._id}}" disabled="{{busy || item.skippedToday}}" bindtap="skip">{{item.skippedToday ? '今天已跳过' : '今天不用来'}}</button></view><empty-state wx:if="{{!loading && !cards.length}}" message="你还没有月卡"/></view>
