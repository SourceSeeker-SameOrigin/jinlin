<view class="page">
  <view wx:if="{{loading}}" class="card">正在加载…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <block wx:elif="{{user}}">
    <view wx:for="{{user.moderationNotices}}" wx:key="createdAt" class="card error">{{item.message}}</view>
    <view class="profile-heading"><view class="avatar-disc"><image class="profile-avatar" src="/assets/icons/avatar.png"/></view><view><view class="profile-name">微信用户</view><text class="pill">✓ 已登录</text><view class="muted">{{user.buildingId ? '服务资料已填写' : '门牌与联系电话待完善'}}</view></view></view>
    <navigator class="profile-address" url="/pages/bind/bind"><image src="/assets/icons/home.png" class="address-icon"/><view class="menu-copy"><view class="profile-card-title">{{user.buildingId ? '我的服务门牌' : '完善服务资料'}}</view><view class="muted">{{community.name || '绑定门牌后使用本小区服务'}}</view><view wx:if="{{user.buildingId}}">{{user.buildingName}} {{user.unit}} {{user.room}}</view><view wx:if="{{user.phone}}" class="muted">{{user.phone}} · {{user.phoneVerified ? '微信授权' : '未验证联系电话'}}</view></view><text class="profile-action">{{user.buildingId ? '修改' : '去完善'}}</text></navigator>
    <view class="section-title">我的服务</view>
    <view class="account-grid"><navigator class="account-item" url="/pages/orders/list" open-type="switchTab"><image class="menu-icon" src="/assets/icons/orders.png"/>我的订单</navigator><navigator class="account-item" url="/pages/membership/index"><image class="menu-icon" src="/assets/icons/ticket.png"/>我的月卡</navigator><navigator class="account-item" url="/pages/bind/bind"><image class="menu-icon" src="/assets/icons/pin.png"/>服务地址</navigator><button class="account-item" bindtap="callHotline"><image class="menu-icon" src="/assets/icons/support.png"/>联系客服</button></view>
    <view wx:if="{{community.features.stationDelivery}}" class="card"><text>快递默认送上门</text><switch checked="{{doorDelivery}}" disabled="{{doorDeliveryBusy}}" bindchange="doorDeliveryChange"/><view class="muted">开启后表示同意驿站将快递送到门口，可随时关闭。</view></view>
    <navigator wx:if="{{community.enabledFeatures.board}}" class="card" url="/board/list/list">需求广场 ›</navigator>
    <navigator wx:if="{{community.enabledFeatures.idle}}" class="card" url="/idle/mine/mine">我的闲置 ›</navigator>
    <navigator wx:if="{{community.enabledFeatures.chat}}" class="card" url="/chat/list/list">站内消息<text wx:if="{{unreadTotal}}"> · {{unreadTotal}} 条未读</text> ›</navigator>
    <navigator wx:if="{{community.enabledFeatures.coupons}}" class="card" url="/coupons/mine/mine">我的优惠券 ›</navigator>
    <navigator wx:if="{{community.enabledFeatures.events && canManageEvents}}" class="card" url="/events/manage/manage">活动管理 ›</navigator>
    <navigator wx:if="{{community.features.merchants && merchant.status === 'approved'}}" class="card" url="/merchant/workbench/workbench">商家工作台 ›</navigator><navigator wx:elif="{{community.features.merchants}}" class="card" url="/merchant/apply/apply">{{merchant ? '查看商家入驻审核' : '申请商家入驻'}} ›</navigator>
    <navigator wx:if="{{isStation}}" class="card" url="/station/workbench/workbench">驿站工作台 ›</navigator>
    <navigator wx:elif="{{community.features.stationDelivery}}" class="card" url="/station/apply/apply">{{stationApplication ? (stationApplication.status === 'pending' ? '驿站入驻审核中' : stationApplication.status === 'rejected' ? '驿站申请未通过，查看原因' : '申请驿站账号') : '申请驿站账号'}} ›</navigator>
    <view class="section-title">参与邻里服务</view>
    <navigator wx:if="{{provider.status === 'approved'}}" class="card" url="/provider/workbench/workbench">服务员工作台 ›</navigator>
    <navigator wx:else class="join-neighbors" url="/provider/apply/apply"><image class="join-icon" src="/assets/icons/help.png"/><view class="menu-copy"><view class="join-title">{{provider ? '查看服务员申请' : '成为邻居帮手'}}</view><view class="muted">提交申请，审核后接单</view></view><text class="chevron">›</text></navigator>
    <navigator wx:if="{{manage}}" class="card" url="/admin/dashboard/dashboard">管理后台 ›</navigator>

    <view class="legal-menu"><navigator class="menu-row" url="/pages/legal/privacy"><image class="menu-icon" src="/assets/icons/shield.png"/><text>隐私政策</text><text class="chevron">›</text></navigator><navigator class="menu-row" url="/pages/legal/terms"><image class="menu-icon" src="/assets/icons/legal.png"/><text>服务协议</text><text class="chevron">›</text></navigator></view><view class="page-footer">邻里互助，安心到家</view>
  </block>
</view>
<privacy-popup />
