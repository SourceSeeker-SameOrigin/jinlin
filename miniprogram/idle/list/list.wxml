<view class="page">
  <view class="page-title">闲置交易</view>
  <view wx:if="{{federationEnabled}}" class="tabs"><button data-scope="community" bindtap="scope">本小区</button><button data-scope="federation" bindtap="scope">联合社区</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="open">
    <view wx:if="{{item.sourceCommunityName}}" class="muted">来自 {{item.sourceCommunityName}}</view>
    <view class="section-title">{{item.title}}</view><view>{{item.desc}}</view>
    <view class="price">¥{{item.priceText}}</view><view class="muted">{{item.condition}} · {{item.timeText}}</view>
  </view>
  <view wx:if="{{loading}}" class="muted">正在加载…</view><view wx:elif="{{!list.length && !error}}" class="muted">还没有邻居发布闲置</view>
  <button wx:if="{{hasMore}}" bindtap="more">加载更多</button>
  <button type="primary" bindtap="create">发布闲置</button><button bindtap="mine">我的闲置</button>
</view>
