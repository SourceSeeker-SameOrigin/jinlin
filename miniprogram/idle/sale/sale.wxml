<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{order}}"><view class="card"><view class="page-title">{{order.detail.title}} · {{order.statusText}}</view><view>买家已支付 ¥{{priceText}}</view><view>预计到账 ¥{{payoutText}}</view><view wx:for="{{order.detail.images}}" wx:key="*this"><image class="photo" src="{{item}}" mode="aspectFill"/></view></view><button wx:if="{{order.status === 'paid'}}" type="primary" bindtap="accept" loading="{{busy}}">确认接单</button><view wx:if="{{order.status === 'accepted'}}" class="card"><view class="section-title">交付凭证</view><view>拍摄商品交付情况，勿拍摄无关人员或证件。</view><image wx:for="{{photos}}" wx:key="*this" class="photo" src="{{item}}" data-url="{{item}}" bindtap="preview"/><button bindtap="photos">拍摄交付凭证（1—3 张）</button><textarea value="{{note}}" bindinput="note" maxlength="300" placeholder="交付说明（选填）"/><button type="primary" bindtap="deliver" loading="{{busy}}">提交交付，等待买家确认</button></view><view wx:if="{{order.status === 'delivered'}}" class="card">已提交交付。买家确认或交付满 72 小时后，订单将完成并进入结算。</view><view wx:if="{{order.idleSale.delivery}}" class="card"><view class="section-title">交付记录</view><view>{{order.idleSale.delivery.note}}</view><image wx:for="{{order.idleSale.delivery.photos}}" wx:key="*this" class="photo" src="{{item}}" mode="aspectFill"/></view></block><view wx:if="{{loading}}" class="muted">正在加载…</view></view>
