<view class="page">
  <view class="page-title">{{itemId ? '编辑闲置' : '发布闲置'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <input placeholder="商品名称" maxlength="80" value="{{title}}" data-field="title" bindinput="field"/>
  <textarea placeholder="描述商品情况" maxlength="2000" value="{{desc}}" data-field="desc" bindinput="field"/>
  <input placeholder="分类（选填）" maxlength="40" value="{{category}}" data-field="category" bindinput="field"/>
  <input type="digit" placeholder="价格（元）" value="{{priceYuan}}" data-field="priceYuan" bindinput="field"/>
  <picker range="{{conditionOptions}}" value="{{conditionIndex}}" bindchange="condition"><view class="picker">成色：{{conditionOptions[conditionIndex]}}</view></picker>
  <label class="row"><switch checked="{{negotiable}}" data-field="negotiable" bindchange="switch"/>接受议价</label>
  <picker wx:if="{{escrowEnabled}}" range="{{tradeModes}}" value="{{tradeModeIndex}}" bindchange="tradeMode"><view class="picker">交易方式：{{tradeModes[tradeModeIndex]}}</view></picker>
  <picker wx:if="{{federationEnabled}}" range="{{scopeOptions}}" value="{{scope === 'federation' ? 1 : 0}}" bindchange="scope"><view class="picker">{{scope === 'federation' ? '联合社区可见' : '本小区可见'}}</view></picker>
  <view wx:if="{{images.length}}" class="muted">已选 {{images.length}} 张图片</view><button bindtap="photos">添加图片（最多 9 张）</button>
  <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading}}">保存并发布</button>
</view>
