<view class="page"><view class="page-title">批次进度</view><view class="card"><view class="field"><text class="label">对账月份</text><picker mode="date" fields="month" value="{{month}}" bindchange="monthChange"><view class="picker">{{month}}</view></picker></view><button type="primary" loading="{{exporting}}" disabled="{{exporting}}" bindtap="exportStatement">导出月度对账CSV</button></view><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><view class="card" wx:for="{{batches}}" wx:key="_id"><view class="section-title">批次 {{item._id}} · {{item.status === 'open' ? '待接单' : item.status === 'assigned' ? '配送中' : '已完成'}}</view><view>创建时间 {{item.createdText}}</view><view>{{item.itemCount}} 户 · 已送达 {{item.deliveredCount}} · 未送达 {{item.failedCount}}</view></view><empty-state wx:if="{{loading}}" message="正在加载批次…"/><empty-state wx:elif="{{!error && !batches.length}}" message="当前没有批次"/></view>
<privacy-popup />
