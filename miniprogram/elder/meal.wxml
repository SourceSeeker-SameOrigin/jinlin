<view class="page service-page"><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{community}}"><view class="card"><view class="page-title">送餐上门</view><view class="muted">服务员到合作食堂取餐并送到门口，餐费按实际小票结算。</view><view wx:if="{{addresses.length > 1}}" class="field"><text class="label">服务地址</text><picker range="{{addresses}}" range-key="buildingName" value="{{addressIndex}}" bindchange="addressChange"><view class="picker">{{addressText}} · 切换地址</view></picker></view></view><view class="card"><view class="field"><text class="label">合作食堂</text><picker wx:if="{{community.canteens.length}}" range="{{community.canteens}}" range-key="name" value="{{form.canteenIndex}}" data-field="canteenIndex" bindchange="change"><view class="picker">{{community.canteens[form.canteenIndex].name}}</view></picker><view wx:else class="muted">本小区尚未配置合作食堂，请联系物业。</view></view><view class="field"><text class="label">餐品清单</text><textarea value="{{form.items}}" data-field="items" bindinput="change" maxlength="200" placeholder="请写明餐品和数量"/></view><view class="field"><text class="label">餐费预付上限（元）</text><input type="digit" value="{{form.goodsYuan}}" data-field="goodsYuan" bindinput="change"/><view class="muted">服务完成后按小票退还餐费差额。</view></view><view class="field"><text class="label">送餐时段</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || '请选择时段'}}</view></picker><view class="muted">{{dutyHint}}</view></view><view class="field"><text class="label">备注</text><textarea value="{{form.note}}" data-field="note" bindinput="change" maxlength="100"/></view></view><view wx:if="{{quoteError}}" class="error">{{quoteError}}</view><price-bar amount="{{amount}}" reason="{{quote.reason}}" disabled="{{!quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view><privacy-popup/>
